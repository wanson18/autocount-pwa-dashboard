{
  "version": 2,
  "functions": {
    "api/price-check.js": { "regions": ["sin1"] },
    "api/sales.js": { "regions": ["sin1"] },
    "api/dispatch-invoices.js": { "regions": ["sin1"] },
    "api/dispatch-session.js": { "regions": ["iad1"] },
    "api/dispatch-resources.js": { "regions": ["iad1"] },
    "api/dispatch-trips.js": { "regions": ["iad1"] },
    "api/dispatch-assignments.js": { "regions": ["iad1"] },
    "api/dispatch-reports.js": { "regions": ["iad1"] },
    "api/dispatch-loading-sheet.js": { "regions": ["iad1"] },
    "api/dispatch-unknown.js": { "regions": ["iad1"] }
  },
  "rewrites": [
    {
      "source": "/api/dispatch/session",
      "destination": "/api/dispatch-session.js"
    },
    {
      "source": "/api/dispatch/resources",
      "destination": "/api/dispatch-resources.js"
    },
    {
      "source": "/api/dispatch/invoices",
      "destination": "/api/dispatch-invoices.js"
    },
    {
      "source": "/api/dispatch/trips",
      "destination": "/api/dispatch-trips.js"
    },
    {
      "source": "/api/dispatch/assignments",
      "destination": "/api/dispatch-assignments.js"
    },
    {
      "source": "/api/dispatch/loading-sheet",
      "destination": "/api/dispatch-loading-sheet.js"
    },
    {
      "source": "/api/dispatch/reports",
      "destination": "/api/dispatch-reports.js"
    },
    {
      "source": "/api/dispatch",
      "destination": "/api/dispatch-unknown.js"
    },
    {
      "source": "/api/dispatch/(.*)",
      "destination": "/api/dispatch-unknown.js"
    },
    {
      "source": "/api/price-check",
      "destination": "/api/price-check.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/sales.js"
    }
  ],
  "headers": [
    {
      "source": "/api/sales",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/api/dispatch/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/dispatch-(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
