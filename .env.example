# AutoCount Cloud API (server-side only). Sales, Dispatch and Price Check read
# these settings the same way (lib/autocount/company-config.js). The two books
# are fixed in code: Wanson Enterprise 63750 and Wanson Sdn Bhd 63688.
AUTOCOUNT_API_URL=https://accounting-api.autocountcloud.com
# Optional per-book address. Leave blank to use AUTOCOUNT_API_URL.
AUTOCOUNT_ENTERPRISE_API_URL=
AUTOCOUNT_SDN_BHD_API_URL=

# Each book uses its own credential pair; never reuse Enterprise credentials
# for Sdn Bhd. These names are read first...
AUTOCOUNT_ENTERPRISE_API_KEY=your-enterprise-api-key-here
AUTOCOUNT_ENTERPRISE_KEY_ID=your-enterprise-key-id-here
AUTOCOUNT_SDN_BHD_API_KEY=your-sdn-bhd-api-key-here
AUTOCOUNT_SDN_BHD_KEY_ID=your-sdn-bhd-key-id-here

# ...then these aliases. A key and its ID may come from either style, but a book
# with only one half of its pair is refused. Leave blank unless used.
AUTOCOUNT_API_KEY_WANSON_ENTERPRISE=
AUTOCOUNT_KEY_ID_WANSON_ENTERPRISE=
AUTOCOUNT_API_KEY_WANSON_SDN_BHD=
AUTOCOUNT_KEY_ID_WANSON_SDN_BHD=

# Optional double-check. When set, each must equal its fixed book number or that
# book is refused; nothing else can choose a book.
AUTOCOUNT_ACCOUNT_BOOK_WANSON_ENTERPRISE=63750
AUTOCOUNT_ACCOUNT_BOOK_WANSON_SDN_BHD=63688

# Old shared pair: Enterprise only, and only when none of its own names is set.
# AUTOCOUNT_KEY_ID is read before AUTOCOUNT_API_KEY_ID. Sdn Bhd never uses it.
AUTOCOUNT_API_KEY=
AUTOCOUNT_KEY_ID=
AUTOCOUNT_API_KEY_ID=

# Cache TTL in minutes (default: 10)
CACHE_TTL_MINUTES=10

# Set to "true" to use mock data instead of live API
USE_MOCK_DATA=false

# IANA timezone used to decide what "today" means for default date ranges.
# Serverless hosts run in UTC, so this must be set explicitly (default: Asia/Kuala_Lumpur)
REPORT_TIMEZONE=Asia/Kuala_Lumpur

# Pooled Postgres connection for dispatch persistence. Use a pooled provider URL.
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# Dispatch clerk authentication (server-side only; leave blank until configured).
# DISPATCH_SESSION_SECRET must be base64url for exactly 32 random bytes (43 chars,
# no '=' padding). Generate one with a cryptographically secure random generator.
# DISPATCH_USERS_JSON must be a JSON array of objects with exactly clerkId, role,
# active, and a canonical scrypt$N$r$p$salt$derived-key pinHash field. The only
# approved profile is N=16384, r=8, p=1, a 16-byte salt, and a 64-byte key.
# Alternate bounded profiles, malformed encodings, and duplicate parameters fail closed.
DISPATCH_USERS_JSON=
DISPATCH_SESSION_SECRET=
# Set true only when the dispatch board and its read/write APIs should be public.
# Public access bypasses clerk authentication; keep false for the normal protected mode.
DISPATCH_PUBLIC_ACCESS=false
# Set only when the deployment's forwarded client address is trusted. Leave blank
# on platforms where the runtime already supplies a trusted request IP.
DISPATCH_TRUSTED_PROXY=

# Optional temporary Postgres URL for the repository integration test run.
# Without this value, the suite uses in-memory WASM PostgreSQL.
# TEST_DATABASE_URL=postgres://user:password@host:5432/test_database?sslmode=require
