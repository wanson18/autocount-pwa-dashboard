# AutoCount Cloud API Credentials
AUTOCOUNT_API_URL=https://accounting-api.autocountcloud.com
AUTOCOUNT_API_KEY=your-api-key-here
AUTOCOUNT_KEY_ID=your-key-id-here
AUTOCOUNT_ACCOUNT_BOOK_ID=63688

# Cache TTL in minutes (default: 10)
CACHE_TTL_MINUTES=10

# Set to "true" to use mock data instead of live API
USE_MOCK_DATA=false

# IANA timezone used to decide what "today" means for default date ranges.
# Serverless hosts run in UTC, so this must be set explicitly (default: Asia/Kuala_Lumpur)
REPORT_TIMEZONE=Asia/Kuala_Lumpur
