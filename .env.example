# AutoCount Cloud API Credentials (server-side only)
AUTOCOUNT_API_URL=https://accounting-api.autocountcloud.com

# Required account books. Keep these values distinct and never accept them from a client.
AUTOCOUNT_ACCOUNT_BOOK_WANSON_ENTERPRISE=your-enterprise-account-book
AUTOCOUNT_ACCOUNT_BOOK_WANSON_SDN_BHD=your-sdn-bhd-account-book

# Prefer a separate Key-ID/API-Key pair for each account book.
AUTOCOUNT_KEY_ID_WANSON_ENTERPRISE=your-enterprise-key-id
AUTOCOUNT_API_KEY_WANSON_ENTERPRISE=your-enterprise-api-key
AUTOCOUNT_KEY_ID_WANSON_SDN_BHD=your-sdn-bhd-key-id
AUTOCOUNT_API_KEY_WANSON_SDN_BHD=your-sdn-bhd-api-key

# Optional shared fallback. Set both values or neither; never set only one.
AUTOCOUNT_API_KEY_ID=your-shared-key-id
AUTOCOUNT_API_KEY=your-shared-api-key

# Cache TTL in minutes (default: 10)
CACHE_TTL_MINUTES=10

# Set to "true" to use mock data instead of live API
USE_MOCK_DATA=false

# IANA timezone used to decide what "today" means for default date ranges.
# Serverless hosts run in UTC, so this must be set explicitly (default: Asia/Kuala_Lumpur)
REPORT_TIMEZONE=Asia/Kuala_Lumpur
